<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- التطبيق يعمل على التلفاز والجوال؛ لا نشترط شاشة لمس ولا Leanback -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!-- الخدمة الأمامية (Foreground Service) لحماية الخدمة من الإغلاق -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- نافذة عائمة فوق التطبيقات لرفع أولوية التطبيق ومنع إغلاقه -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- لتشغيل الحارس بعد إقلاع الجهاز -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- تُمنح مرة واحدة عبر ADB حتى يعيد التطبيق تفعيل خدمته إذا أطفأها النظام:
         adb shell pm grant com.tvremote.keyboard android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/app_banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- يظهر في مشغّل التطبيقات العادي -->
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- يظهر في واجهة Android TV (Leanback) -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".KeyboardRemoteService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
            <!-- مطلوب في Android 14+ لنوع specialUse -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the keyboard-to-remote accessibility service alive on TV boxes" />
        </service>

        <!-- الحارس: منبّه دوري + بعد الإقلاع + بعد تحديث التطبيق -->
        <receiver
            android:name=".GuardReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="com.tvremote.keyboard.GUARD_CHECK" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
