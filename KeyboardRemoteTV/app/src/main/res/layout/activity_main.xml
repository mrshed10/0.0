<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="32dp"
        android:paddingEnd="48dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />

        <!-- مؤشر حالة الخدمة -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/status_disabled_bg"
            android:paddingStart="28dp"
            android:paddingTop="10dp"
            android:paddingEnd="28dp"
            android:paddingBottom="10dp"
            android:text="@string/status_disabled"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- الزر الرئيسي في منتصف الشاشة -->
        <Button
            android:id="@+id/openSettingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/button_bg"
            android:focusable="true"
            android:minWidth="420dp"
            android:paddingStart="40dp"
            android:paddingTop="18dp"
            android:paddingEnd="40dp"
            android:paddingBottom="18dp"
            android:text="@string/open_settings"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/how_to_enable"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <!-- جدول الأزرار -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/table_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/table_bg"
            android:padding="2dp"
            android:stretchColumns="1">

            <TableRow android:background="@color/header_bg">
                <TextView style="@style/TableHeader" android:text="@string/col_key" />
                <TextView style="@style/TableHeader" android:text="@string/col_action" />
            </TableRow>

            <TableRow style="@style/TableRowFocusable">
                <TextView style="@style/TableKey" android:text="F12" />
                <TextView style="@style/TableCell" android:text="@string/act_volume_up" />
            </TableRow>

            <TableRow style="@style/TableRowFocusable">
                <TextView style="@style/TableKey" android:text="F11" />
                <TextView style="@style/TableCell" android:text="@string/act_volume_down" />
            </TableRow>

            <TableRow style="@style/TableRowFocusable">
                <TextView style="@style/TableKey" android:text="F10" />
                <TextView style="@style/TableCell" android:text="@string/act_mute" />
            </TableRow>

            <TableRow style="@style/TableRowFocusable">
                <TextView style="@style/TableKey" android:text="F1 / Home" />
                <TextView style="@style/TableCell" android:text="@string/act_home" />
            </TableRow>

            <TableRow style="@style/TableRowFocusable">
                <TextView style="@style/TableKey" android:text="Esc / Backspace" />
                <TextView style="@style/TableCell" android:text="@string/act_back" />
            </TableRow>

            <TableRow style="@style/TableRowFocusable">
                <TextView style="@style/TableKey" android:text="F2" />
                <TextView style="@style/TableCell" android:text="@string/act_recents" />
            </TableRow>
        </TableLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/note_typing"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
