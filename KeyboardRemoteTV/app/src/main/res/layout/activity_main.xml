<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="32dp"
        android:paddingEnd="48dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />

        <!-- مؤشر حالة الخدمة -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/status_disabled_bg"
            android:paddingStart="28dp"
            android:paddingTop="10dp"
            android:paddingEnd="28dp"
            android:paddingBottom="10dp"
            android:text="@string/status_disabled"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- الزر الرئيسي في منتصف الشاشة -->
        <Button
            android:id="@+id/openSettingsButton"
            style="@style/BigButton"
            android:layout_marginTop="24dp"
            android:background="@drawable/button_secondary_bg"
            android:text="@string/open_settings" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/how_to_enable"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <!-- زر إضافة تخصيص جديد -->
        <Button
            android:id="@+id/addMappingButton"
            style="@style/BigButton"
            android:layout_marginTop="28dp"
            android:text="@string/add_mapping_button" />

        <!-- جدول الأزرار المخصّصة -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/table_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/header_bg"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                style="@style/TableHeader"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/col_key" />

            <TextView
                style="@style/TableHeader"
                android:layout_width="0dp"
                android:layout_weight="1.4"
                android:text="@string/col_action" />

            <TextView
                style="@style/TableHeader"
                android:layout_width="wrap_content"
                android:minWidth="260dp"
                android:text="@string/col_manage" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mappingsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/row_bg"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/empty_mappings"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/note_typing"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
