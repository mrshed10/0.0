<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="28dp"
        android:paddingEnd="48dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tile_tweaks"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- بطاقة فحص صلاحية WRITE_SECURE_SETTINGS -->
        <LinearLayout
            android:id="@+id/permission_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_warning"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/permission_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/grant_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/perm_missing_body"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/grant_command"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/code_bg"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:textColor="#FFE6F0FF"
                android:textDirection="ltr"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_recheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/chip_bg"
                android:minHeight="44dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:stateListAnimator="@null"
                android:text="@string/perm_recheck"
                android:textAllCaps="false"
                android:textColor="@color/chip_text"
                android:textSize="17sp" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_debugging" />

        <Switch
            android:id="@+id/switch_dev"
            style="@style/TvSwitch"
            android:text="@string/switch_dev" />

        <Switch
            android:id="@+id/switch_adb"
            style="@style/TvSwitch"
            android:text="@string/switch_adb" />

        <Switch
            android:id="@+id/switch_wifi_adb"
            style="@style/TvSwitch"
            android:text="@string/switch_wifi_adb" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_animations" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/anim_hint"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/animation_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
