<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview: Nothing-style dot clock (live). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_nothing_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/doto_regular"
        android:format12Hour="EEE"
        android:format24Hour="EEE"
        android:textAllCaps="true"
        android:textColor="#FFD71921"
        android:textSize="14sp" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/doto_regular"
        android:format12Hour="hh:mm"
        android:format24Hour="HH:mm"
        android:textColor="#FFFFFFFF"
        android:textSize="44sp" />
</LinearLayout>
