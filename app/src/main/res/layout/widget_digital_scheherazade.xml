<?xml version="1.0" encoding="utf-8"?>
<!-- Live digital clock (TextClock updates itself, no app wake-ups). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <TextClock
        android:id="@+id/clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="52sp"
        android:fontFamily="@font/scheherazadenew_bold" />

    <TextClock
        android:id="@+id/clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEEE d MMMM"
        android:format24Hour="EEEE d MMMM"
        android:maxLines="1"
        android:textColor="#FFE6C27A"
        android:textSize="14sp"
        android:fontFamily="@font/scheherazadenew_bold" />
</LinearLayout>
