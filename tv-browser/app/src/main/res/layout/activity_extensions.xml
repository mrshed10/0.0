<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/extensions_title"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/ext_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_toolbar_button"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/close"
            android:textColor="@color/text" />
    </LinearLayout>

    <TextView
        android:id="@+id/ext_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/ext_empty"
        android:textColor="@color/text_dim"
        android:textSize="18sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/ext_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:listSelector="@drawable/bg_list_item" />
</LinearLayout>
