<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- سمة داكنة مناسبة لتطبيق كاميرا -->
    <style name="Theme.LocalCam" parent="Theme.Material3.Dark">
        <item name="colorPrimary">@color/primary</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!-- بدون شريط عنوان: للشاشة الرئيسية ومشغل الفيديو -->
    <style name="Theme.LocalCam.Fullscreen" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>
</resources>
