<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#FF3E4A57" /><corners android:radius="12dp" />
            <stroke android:width="3dp" android:color="@android:color/white" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#FF3E4A57" /><corners android:radius="12dp" />
            <stroke android:width="3dp" android:color="@android:color/white" /></shape>
    </item>
    <item android:state_hovered="true">
        <shape><solid android:color="#FF3E4A57" /><corners android:radius="12dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#FF2C3540" /><corners android:radius="12dp" /></shape>
    </item>
</selector>
