<?xml version="1.0" encoding="utf-8"?>
<!-- لوحة التحكم العائمة: تصميم زجاجي داكن، قابلة للتمرير إن كثرت الأزرار -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_glass_bg"
    android:fillViewport="false"
    android:layoutDirection="rtl"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/panel_title"
            android:textColor="@color/glass_text_dim"
            android:textSize="15sp" />

        <!-- أزرار التحكم -->
        <GridLayout
            android:id="@+id/grid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="4" />

        <!-- اختصارات التطبيقات -->
        <LinearLayout
            android:id="@+id/appsSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/PanelSection"
                android:text="@string/panel_apps" />

            <GridLayout
                android:id="@+id/appsGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="6" />
        </LinearLayout>

        <!-- مجموعات التطبيقات -->
        <LinearLayout
            android:id="@+id/groupsSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/PanelSection"
                android:text="@string/panel_groups" />

            <GridLayout
                android:id="@+id/groupsGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="4" />
        </LinearLayout>

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="@string/panel_empty"
            android:textColor="@color/glass_text_dim"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
