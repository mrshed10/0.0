<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية الأزرار: إطار أزرق واضح عند التركيز (ريموت/كيبورد) وتمييز عند مرور الماوس -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/tile_radius" />
                <solid android:color="@color/tile_pressed" />
                <stroke android:width="3dp" android:color="@color/accent" />
            </shape>
    </item>
    <item android:state_focused="true">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/tile_radius" />
                <solid android:color="@color/tile_focused" />
                <stroke android:width="3dp" android:color="@color/accent" />
            </shape>
    </item>
    <item android:state_hovered="true">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/tile_radius" />
                <solid android:color="@color/tile_hovered" />
                <stroke android:width="2dp" android:color="@color/accent_dim" />
            </shape>
    </item>
    <item android:state_activated="true">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/tile_radius" />
                <solid android:color="@color/tile_activated" />
                <stroke android:width="2dp" android:color="@color/accent_dim" />
            </shape>
    </item>
    <item>
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/tile_radius" />
                <solid android:color="@color/tile" />
                <stroke android:width="1dp" android:color="@color/tile_border" />
            </shape>
    </item>
</selector>
